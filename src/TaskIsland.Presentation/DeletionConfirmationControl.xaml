<UserControl x:Class="TaskIsland.Presentation.DeletionConfirmationControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/IslandTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Border Background="#171C25" CornerRadius="12" Padding="16" BorderBrush="#535D73" BorderThickness="1">
  <StackPanel VerticalAlignment="Center">
   <TextBlock Text="删除归档日程" Foreground="{StaticResource IslandText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
   <TextBlock Text="{Binding DeletePrompt}" Foreground="{StaticResource IslandMuted}" FontSize="12" TextWrapping="Wrap"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="取消" Command="{Binding CancelDeleteCommand}"/><Button Content="彻底删除" Command="{Binding ConfirmDeleteCommand}" Background="#793D47"/></StackPanel>
  </StackPanel>
 </Border>
</UserControl>
