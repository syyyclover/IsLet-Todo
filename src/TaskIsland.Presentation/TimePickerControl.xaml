<UserControl x:Class="TaskIsland.Presentation.TimePickerControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/IslandTheme.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>
 <StackPanel>
  <DockPanel><DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding IsPickerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style><Button Content="设置时间" Command="{Binding OpenCommand}" DockPanel.Dock="Right"/><Button Content="移除" Command="{Binding RemoveCommand}" DockPanel.Dock="Right" Style="{StaticResource QuietButton}"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource IslandMuted}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
  <StackPanel Visibility="{Binding IsPickerOpen, Converter={StaticResource Visible}}">

   <UniformGrid Columns="3">
    <StackPanel><TextBlock Text="日期" HorizontalAlignment="Center" Foreground="{StaticResource IslandMuted}"/><Button MinHeight="20" Padding="0" Margin="1,0" Content="▴" Tag="date" Click="Up" AutomationProperties.Name="后一天"/><Border Tag="date" Focusable="True" PreviewMouseWheel="Wheel" PreviewKeyDown="Key" MouseLeftButtonDown="DragStart" MouseLeftButtonUp="DragEnd" MouseMove="DragMove" Background="#252A35" CornerRadius="8" Padding="2,6" AutomationProperties.Name="日期滚轮"><TextBlock Text="{Binding DateLabel}" Foreground="{StaticResource IslandText}" HorizontalAlignment="Center"/></Border><Button MinHeight="20" Padding="0" Margin="1,0" Content="▾" Tag="date" Click="Down" AutomationProperties.Name="前一天"/></StackPanel>
    <StackPanel><TextBlock Text="小时" HorizontalAlignment="Center" Foreground="{StaticResource IslandMuted}"/><Button MinHeight="20" Padding="0" Margin="1,0" Content="▴" Tag="hour" Click="Up" AutomationProperties.Name="增加小时"/><Border Tag="hour" Focusable="True" PreviewMouseWheel="Wheel" PreviewKeyDown="Key" MouseLeftButtonDown="DragStart" MouseLeftButtonUp="DragEnd" MouseMove="DragMove" Background="#252A35" CornerRadius="8" Padding="2,6" AutomationProperties.Name="小时滚轮"><TextBlock Text="{Binding HourLabel}" Foreground="{StaticResource IslandText}" HorizontalAlignment="Center"/></Border><Button MinHeight="20" Padding="0" Margin="1,0" Content="▾" Tag="hour" Click="Down" AutomationProperties.Name="减少小时"/></StackPanel>
    <StackPanel><TextBlock Text="分钟" HorizontalAlignment="Center" Foreground="{StaticResource IslandMuted}"/><Button MinHeight="20" Padding="0" Margin="1,0" Content="▴" Tag="minute" Click="Up" AutomationProperties.Name="增加分钟"/><Border Tag="minute" Focusable="True" PreviewMouseWheel="Wheel" PreviewKeyDown="Key" MouseLeftButtonDown="DragStart" MouseLeftButtonUp="DragEnd" MouseMove="DragMove" Background="#252A35" CornerRadius="8" Padding="2,6" AutomationProperties.Name="分钟滚轮"><TextBlock Text="{Binding MinuteLabel}" Foreground="{StaticResource IslandText}" HorizontalAlignment="Center"/></Border><Button MinHeight="20" Padding="0" Margin="1,0" Content="▾" Tag="minute" Click="Down" AutomationProperties.Name="减少分钟"/></StackPanel>
   </UniformGrid>
   <TextBlock Text="{Binding Preview}" Foreground="{StaticResource IslandText}" HorizontalAlignment="Center" FontSize="12" Margin="0,4"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Command="{Binding CancelCommand}"/><Button Content="确认时间" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </StackPanel>
  <TextBlock Text="{Binding Error}" Foreground="#F0A8A0" TextWrapping="Wrap" FontSize="12"/>
 </StackPanel>
</UserControl>
