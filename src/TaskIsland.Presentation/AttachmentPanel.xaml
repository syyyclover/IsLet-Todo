<UserControl x:Class="TaskIsland.Presentation.AttachmentPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/IslandTheme.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="Visible"/></ResourceDictionary></UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel><TextBlock Text="附件" Foreground="{StaticResource IslandText}" Margin="5"/><Button Content="取消复制" Command="{Binding CancelAttachmentCopyCommand}" Visibility="{Binding IsAttachmentCopying,Converter={StaticResource Visible}}" DockPanel.Dock="Right"/><ProgressBar Height="4" Maximum="100" Value="{Binding AttachmentProgressPercent}" Visibility="{Binding IsAttachmentCopying,Converter={StaticResource Visible}}"/></DockPanel>
  <ListBox Grid.Row="1" ItemsSource="{Binding Attachments}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4" LastChildFill="True">
    <Button DockPanel.Dock="Right" Content="移除" Command="{Binding DataContext.RequestRemoveAttachmentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,3"/>
    <Button DockPanel.Dock="Right" Content="打开" AutomationProperties.Name="使用系统应用打开附件" Command="{Binding DataContext.OpenAttachmentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="6,3"/>
    <Button Command="{Binding DataContext.PreviewAttachmentCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Left" Style="{StaticResource QuietButton}" Padding="2"><TextBlock Text="{Binding OriginalName}" TextTrimming="CharacterEllipsis"/></Button>
   </DockPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <Border Grid.RowSpan="2" Background="#171C25" Visibility="{Binding HasAttachmentPreview,Converter={StaticResource Visible}}" Padding="4"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><Button Content="返回附件" Command="{Binding CloseAttachmentPreviewCommand}"/><Button Content="系统应用打开" Command="{Binding OpenAttachmentCommand}" CommandParameter="{Binding AttachmentPreviewItem}"/></StackPanel><Image Source="{Binding AttachmentPreview}" Stretch="Uniform"/></DockPanel></Border>
  <Border Grid.RowSpan="2" Background="#171C25" Visibility="{Binding ConfirmRemoveAttachment,Converter={StaticResource Visible}}" Padding="12"><StackPanel VerticalAlignment="Center"><TextBlock Text="移除此附件副本？来源文件会保留。" Foreground="{StaticResource IslandText}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="取消" Command="{Binding CancelRemoveAttachmentCommand}"/><Button Content="移除副本" Command="{Binding ConfirmAttachmentRemovalCommand}"/></StackPanel></StackPanel></Border>
 </Grid>
</UserControl>
