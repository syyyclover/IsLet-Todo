<Window x:Class="TaskIsland.Presentation.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskIsland.Presentation"
 Title="IsLet-Todo" Width="360" Height="295" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual"
 AllowDrop="True" PreviewDragEnter="OnAttachmentDragEnter" PreviewDragOver="OnAttachmentDragOver" PreviewDragLeave="OnAttachmentDragLeave" PreviewDrop="OnAttachmentDrop" MouseEnter="OnPointerEnter" MouseLeave="OnPointerLeave" PreviewKeyDown="OnKeyDown" UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/IslandTheme.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolVisibility"/></ResourceDictionary></Window.Resources>
 <Canvas>
 <Border x:Name="IslandSurface" Width="360" Height="295" Background="#F51A1C24" BorderBrush="#393D49" BorderThickness="1" CornerRadius="20">
  <Border.Clip><RectangleGeometry x:Name="IslandClip" Rect="60,0,240,40" RadiusX="20" RadiusY="20"/></Border.Clip>
  <Canvas>
   <Grid Width="336" Height="38" Canvas.Left="12">
    <Grid.RenderTransform><TranslateTransform x:Name="HeaderOffset" X="60"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Ellipse Width="7" Height="7" Fill="#A6D9B5" HorizontalAlignment="Left"/>
    <TextBlock Grid.Column="1" Text="{Binding FeaturedTitle}" Foreground="#F3F4F7" FontSize="14" VerticalAlignment="Center" MouseLeftButtonUp="OnEmptyClick"/>
    <Button x:Name="BackButton" Grid.Column="2" Content="‹" Visibility="Collapsed" Click="OnBack" Padding="10,2" AutomationProperties.Name="返回日程列表"/>
   </Grid>
   <StackPanel x:Name="ContentPanel" Canvas.Left="12" Canvas.Top="45" Width="334" Visibility="Hidden" Opacity="0">
    <StackPanel.RenderTransform><TranslateTransform x:Name="ContentOffset" Y="8"/></StackPanel.RenderTransform>
    <StackPanel x:Name="PageTabs" Orientation="Horizontal" Margin="0,0,0,6"><Button x:Name="TasksTab" Content="日程" Style="{StaticResource QuietButton}" Click="OnTasks"/><Button x:Name="ArchiveTab" Content="归档" Style="{StaticResource QuietButton}" Click="OnArchive"/><Button x:Name="SettingsTab" Content="设置" Style="{StaticResource QuietButton}" Click="OnSettings"/></StackPanel>
    <Grid x:Name="PageDeck" Height="174" ClipToBounds="True">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border x:Name="ErrorBanner" Grid.Row="0" Visibility="{Binding IsError, Converter={StaticResource BoolVisibility}}" Background="#48272D" CornerRadius="8" Padding="8,5" Margin="3,0,3,5">
      <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="OnDismissError" Style="{StaticResource QuietButton}" Padding="5,0" MinHeight="22" AutomationProperties.Name="关闭错误提示"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#F2A5A5" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
     </Border>
    <StackPanel Grid.Row="1" x:Name="TasksPanel" VerticalAlignment="Top">

     <Button x:Name="AddTaskButton" Content="＋  添加日程" AutomationProperties.Name="添加日程" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Height="34" Margin="3,0,3,8"/>
     <Grid Height="114">
      <StackPanel x:Name="EmptyTasksPanel" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Path Data="M5,2 L5,6 M17,2 L17,6 M2,5 L20,5 20,20 2,20 Z M6,11 L10,11 M6,15 L14,15" Stroke="{StaticResource IslandMuted}" StrokeThickness="1.3" Opacity="0.5" Width="28" Height="28" Stretch="Uniform"/></StackPanel>
     <ListBox x:Name="ActiveList" ItemsSource="{Binding Tasks}" Height="114" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">

      <ListBox.ItemTemplate><DataTemplate>
       <Grid Height="46" MouseRightButtonUp="OnTaskRightClick">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="8,6"><TextBlock Text="{Binding Title}" Foreground="#F3F4F7" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#939CAD" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.OpenAttachmentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="附件" Width="Auto" MinWidth="26"><StackPanel Orientation="Horizontal"><Path Data="M4,9 L9,4 Q13,0 15,4 Q17,6 13,10 L7,16 Q3,19 1,15 Q0,13 3,10 L10,3" Style="{StaticResource TaskIcon}"/><TextBlock Text="{Binding AttachmentCount}" FontSize="10" Margin="2,0,0,0"/></StackPanel></Button><Button Style="{StaticResource IconButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="编辑日程"><Path Style="{StaticResource TaskIcon}" Data="{StaticResource EditIcon}"/></Button>
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="标记完成"><Path Style="{StaticResource TaskIcon}" Data="{StaticResource CompleteIcon}"/></Button>
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="归档日程"><Path Style="{StaticResource TaskIcon}" Data="{StaticResource ArchiveIcon}"/></Button>
         <Button Style="{StaticResource IconButton}" Click="OnRenewClick" AutomationProperties.Name="延长保留时间"><local:HourglassControl ArchiveAtUtc="{Binding Item.ArchiveAtUtc}" IsRunning="{Binding IsCountdownRunning, RelativeSource={RelativeSource AncestorType=Window}}" AnimationsEnabled="{Binding DataContext.AnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Width="14" Height="14"/></Button>
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="置顶或取消置顶"><Path Data="{StaticResource PinIcon}"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource TaskIcon}"><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Stroke" Value="{StaticResource IslandAccent}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
        </StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     </Grid>
    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="SettingsPanel" Visibility="Collapsed">
     <TextBlock Text="岛的位置" Foreground="#F3F4F7" Margin="5,5"/>
     <StackPanel Orientation="Horizontal"><Button Content="左侧" Tag="Left" Click="OnAnchor"/><Button Content="居中" Tag="Center" Click="OnAnchor"/><Button Content="右侧" Tag="Right" Click="OnAnchor"/></StackPanel>
     <CheckBox Content="启用动画" IsChecked="{Binding AnimationsEnabled}" Foreground="#F3F4F7" Margin="6,12"/>
     <CheckBox x:Name="AutoStartCheck" Content="登录时启动" Click="OnAutoStart" Foreground="#F3F4F7" Margin="6,2,6,8"/>

    </StackPanel>
    <StackPanel Grid.Row="1" x:Name="ArchivePanel" Visibility="Collapsed">
     <DockPanel><Button Content="清空归档" Style="{StaticResource QuietButton}" DockPanel.Dock="Right" Command="{Binding RequestDeleteAllCommand}"/><TextBlock Text="归档日程" Foreground="#F3F4F7" Margin="5,4" VerticalAlignment="Center"/></DockPanel>
     <ListBox x:Name="ArchiveList" ItemsSource="{Binding ArchivedTasks}" Height="100" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Height="44"><Button Content="附件" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Command="{Binding DataContext.OpenAttachmentsCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="删除" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/><Button Content="恢复" DockPanel.Dock="Right" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4"/><StackPanel Margin="4"><TextBlock Text="{Binding Title}" Foreground="#F3F4F7" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#939CAD" FontSize="10"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Content="加载更多" Command="{Binding LoadMoreArchivesCommand}" Visibility="{Binding HasMoreArchives, Converter={StaticResource BoolVisibility}}" Padding="8,4"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="EditorViewport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="EditorPanel">
     <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding EditorTime.IsPickerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="日程内容" Foreground="#F3F4F7" Margin="5,4"/>
     <TextBox x:Name="TitleInput" Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" MinHeight="40" Margin="3,4" AcceptsReturn="False" VerticalContentAlignment="Center" AutomationProperties.Name="日程内容"/>
     </StackPanel>
     <local:TimePickerControl DataContext="{Binding EditorTime}"/>
     <StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding EditorTime.IsPickerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Style="{StaticResource PrimaryButton}" Content="保存日程" Command="{Binding SaveCommand}" IsDefault="True"/><Button Style="{StaticResource QuietButton}" Content="取消" Command="{Binding CancelEditCommand}"/></StackPanel>
     <StackPanel Visibility="{Binding ConfirmDiscard, Converter={StaticResource BoolVisibility}}"><TextBlock Text="内容尚未保存" Foreground="#E9C88C" Margin="5,5"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="继续编辑" Command="{Binding KeepEditingCommand}"/><Button Content="放弃修改" Command="{Binding DiscardChangesCommand}"/></StackPanel></StackPanel>
    </StackPanel>
    </ScrollViewer>
    <local:AttachmentPanel x:Name="AttachmentsPanel" Grid.Row="1" Visibility="Collapsed"/>
    <Border x:Name="CopyExitPrompt" Grid.Row="1" Visibility="Collapsed" Background="#171C25" CornerRadius="12" Padding="12"><StackPanel VerticalAlignment="Center"><TextBlock Text="附件正在复制" Foreground="{StaticResource IslandText}"/><StackPanel Orientation="Horizontal"><Button Content="等待完成并退出" Click="OnWaitCopyExit"/><Button Content="取消复制并退出" Click="OnCancelCopyExit"/></StackPanel><Button Content="返回" Style="{StaticResource QuietButton}" Click="OnKeepCopying"/></StackPanel></Border>
    <local:DeletionConfirmationControl Grid.Row="1" Visibility="{Binding ConfirmDelete, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center"/>
    </Grid>
   </StackPanel>
  </Canvas>
 </Border>
 </Canvas>
</Window>
