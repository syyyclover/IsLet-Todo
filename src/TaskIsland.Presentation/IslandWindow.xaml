<Window x:Class="TaskIsland.Presentation.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="IsLet-Todo" Width="360" Height="295" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual"
 MouseEnter="OnPointerEnter" MouseLeave="OnPointerLeave" PreviewKeyDown="OnKeyDown" UseLayoutRounding="True">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/></Window.Resources>
 <Canvas>
 <Border x:Name="IslandSurface" Width="360" Height="295" Background="#F51A1C24" BorderBrush="#393D49" BorderThickness="1" CornerRadius="20">
  <Border.Clip><RectangleGeometry x:Name="IslandClip" Rect="60,0,240,40" RadiusX="20" RadiusY="20"/></Border.Clip>
  <Canvas>
   <Grid Width="336" Height="38" Canvas.Left="12">
    <Grid.RenderTransform><TranslateTransform x:Name="HeaderOffset" X="60"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Ellipse Width="7" Height="7" Fill="#A6D9B5" HorizontalAlignment="Left"/>
    <TextBlock Grid.Column="1" Text="{Binding FeaturedTitle}" Foreground="#F3F4F7" FontSize="14" VerticalAlignment="Center" MouseLeftButtonUp="OnEmptyClick" ToolTip="点击查看日程或添加第一条"/>
    <Button x:Name="BackButton" Grid.Column="2" Content="‹" Visibility="Collapsed" Click="OnBack" Padding="10,2" AutomationProperties.Name="返回日程列表"/>
   </Grid>
   <StackPanel x:Name="ContentPanel" Canvas.Left="12" Canvas.Top="45" Width="334" Visibility="Hidden" Opacity="0">
    <StackPanel.RenderTransform><TranslateTransform x:Name="ContentOffset" Y="8"/></StackPanel.RenderTransform>
    <StackPanel x:Name="TasksPanel">
     <DockPanel Margin="0,0,0,4"><Button Content="＋ 添加日程" Command="{Binding AddCommand}" DockPanel.Dock="Right" Padding="9,5"/><Button Content="设置" Click="OnSettings" DockPanel.Dock="Right" Padding="7,5"/><Button Content="归档" Click="OnArchive" DockPanel.Dock="Right" Padding="7,5"/><TextBlock Text="日程" Foreground="#F3F4F7" VerticalAlignment="Center" Margin="5,0"/></DockPanel>
     <ListBox x:Name="ActiveList" ItemsSource="{Binding Tasks}" Height="154" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
       <Grid Height="46" MouseRightButtonUp="OnTaskRightClick">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="4,4"><TextBlock Text="{Binding Title}" Foreground="#F3F4F7" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Detail}" Foreground="#939CAD" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Content="✎" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,4" Margin="1" ToolTip="编辑" AutomationProperties.Name="编辑日程"/>
         <Button Content="✓" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,4" Margin="1" ToolTip="标记完成" AutomationProperties.Name="标记完成"/>
         <Button Content="↓" Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,4" Margin="1" ToolTip="归档" AutomationProperties.Name="归档日程"/>
         <Button Content="⌛" Command="{Binding DataContext.RenewCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="4,4" Margin="1" ToolTip="{Binding ArchiveTooltip}" AutomationProperties.Name="延长保留时间"/>
         <Button Content="{Binding PinGlyph}" Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,4" Margin="1" ToolTip="{Binding PinTooltip}" AutomationProperties.Name="置顶或取消置顶"/>
        </StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </StackPanel>
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
     <TextBlock Text="岛的位置" Foreground="#F3F4F7" Margin="5,5"/>
     <StackPanel Orientation="Horizontal"><Button Content="左侧" Tag="Left" Click="OnAnchor"/><Button Content="居中" Tag="Center" Click="OnAnchor"/><Button Content="右侧" Tag="Right" Click="OnAnchor"/></StackPanel>
     <CheckBox Content="启用动画" IsChecked="{Binding AnimationsEnabled}" Foreground="#F3F4F7" Margin="6,12"/>
     <TextBlock Text="位置和动画设置在退出后恢复默认。" Foreground="#A8AEBC" Margin="5,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel x:Name="ArchivePanel" Visibility="Collapsed">
     <TextBlock Text="归档日程" Foreground="#F3F4F7" Margin="5,4"/>
     <ListBox ItemsSource="{Binding ArchivedTasks}" Height="145" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Height="44"><Button Content="恢复" DockPanel.Dock="Right" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4"/><StackPanel Margin="4"><TextBlock Text="{Binding Title}" Foreground="#F3F4F7" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#939CAD" FontSize="10"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Content="加载更多" Command="{Binding LoadMoreArchivesCommand}" Visibility="{Binding HasMoreArchives, Converter={StaticResource BoolVisibility}}" Padding="8,4"/>
    </StackPanel>
    <StackPanel x:Name="EditorPanel" Visibility="Collapsed">
     <TextBlock Text="日程内容" Foreground="#F3F4F7" Margin="5,4"/>
     <TextBox x:Name="TitleInput" Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" Height="36" Padding="8" Margin="3,4" Background="#303440" Foreground="#F3F4F7" BorderBrush="#535D73" AcceptsReturn="False" VerticalContentAlignment="Center" AutomationProperties.Name="日程内容"/>
     <TextBlock Text="{Binding EditorTimeDescription}" Foreground="#A8AEBC" FontSize="11" Margin="5,6"/>
     <StackPanel Orientation="Horizontal"><Button Content="保存" Command="{Binding SaveCommand}" IsDefault="True"/><Button Content="取消" Command="{Binding CancelEditCommand}"/></StackPanel>
     <StackPanel Visibility="{Binding ConfirmDiscard, Converter={StaticResource BoolVisibility}}"><TextBlock Text="内容尚未保存" Foreground="#E9C88C" Margin="5,5"/><StackPanel Orientation="Horizontal"><Button Content="继续编辑" Command="{Binding KeepEditingCommand}"/><Button Content="放弃修改" Command="{Binding DiscardChangesCommand}"/></StackPanel></StackPanel>
    </StackPanel>
    <TextBlock Text="{Binding Status}" FontSize="11" Margin="5,10,5,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A6D9B5"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#F2A5A5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
  </Canvas>
 </Border>
 </Canvas>
</Window>
