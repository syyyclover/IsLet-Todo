<Window x:Class="TaskIsland.Presentation.IslandWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TaskIsland.Presentation"
 Title="IsLet-Todo" Width="360" Height="295" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Topmost="True" WindowStartupLocation="Manual"
 MouseEnter="OnPointerEnter" MouseLeave="OnPointerLeave" PreviewKeyDown="OnKeyDown" UseLayoutRounding="True" FontFamily="Segoe UI, Microsoft YaHei UI">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/IslandTheme.xaml"/></ResourceDictionary.MergedDictionaries><BooleanToVisibilityConverter x:Key="BoolVisibility"/></ResourceDictionary></Window.Resources>
 <Canvas>
 <Border x:Name="IslandSurface" Width="360" Height="295" Background="#F51A1C24" BorderBrush="#393D49" BorderThickness="1" CornerRadius="20">
  <Border.Clip><RectangleGeometry x:Name="IslandClip" Rect="60,0,240,40" RadiusX="20" RadiusY="20"/></Border.Clip>
  <Canvas>
   <Grid Width="336" Height="38" Canvas.Left="12">
    <Grid.RenderTransform><TranslateTransform x:Name="HeaderOffset" X="60"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Ellipse Width="7" Height="7" Fill="#A6D9B5" HorizontalAlignment="Left"/>
    <TextBlock Grid.Column="1" Text="{Binding FeaturedTitle}" Foreground="#F3F4F7" FontSize="14" VerticalAlignment="Center" MouseLeftButtonUp="OnEmptyClick" ToolTip="点击查看日程或添加第一条"/>
    <Button x:Name="BackButton" Grid.Column="2" Content="‹" Visibility="Collapsed" Click="OnBack" Padding="10,2" AutomationProperties.Name="返回日程列表"/>
   </Grid>
   <StackPanel x:Name="ContentPanel" Canvas.Left="12" Canvas.Top="45" Width="334" Visibility="Hidden" Opacity="0">
    <StackPanel.RenderTransform><TranslateTransform x:Name="ContentOffset" Y="8"/></StackPanel.RenderTransform>
    <StackPanel x:Name="PageTabs" Orientation="Horizontal" Margin="0,0,0,6"><Button x:Name="TasksTab" Content="日程" Style="{StaticResource QuietButton}" Click="OnTasks"/><Button x:Name="ArchiveTab" Content="归档" Style="{StaticResource QuietButton}" Click="OnArchive"/><Button x:Name="SettingsTab" Content="设置" Style="{StaticResource QuietButton}" Click="OnSettings"/></StackPanel>
    <Grid x:Name="PageDeck" Height="174" ClipToBounds="True">
    <StackPanel x:Name="TasksPanel" VerticalAlignment="Top">

     <Button x:Name="AddTaskButton" Content="＋  添加日程" AutomationProperties.Name="添加日程" Style="{StaticResource PrimaryButton}" Command="{Binding AddCommand}" Height="34" Margin="3,0,3,8"/>
     <Grid Height="114">
      <StackPanel x:Name="EmptyTasksPanel" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="从一条小事开始" Foreground="#D6DCE5" FontSize="13" HorizontalAlignment="Center"/><TextBlock Text="点击上方按钮，记下接下来要做的事" Foreground="#939CAD" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"/></StackPanel>
     <ListBox x:Name="ActiveList" ItemsSource="{Binding Tasks}" Height="114" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">

      <ListBox.ItemTemplate><DataTemplate>
       <Grid Height="46" MouseRightButtonUp="OnTaskRightClick">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Margin="8,6"><TextBlock Text="{Binding Title}" Foreground="#F3F4F7" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Detail}" Foreground="#939CAD" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="编辑" AutomationProperties.Name="编辑日程"><Path Style="{StaticResource TaskIcon}" Data="{StaticResource EditIcon}"/></Button>
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.CompleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="标记完成" AutomationProperties.Name="标记完成"><Path Style="{StaticResource TaskIcon}" Data="{StaticResource CompleteIcon}"/></Button>
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.ArchiveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="归档" AutomationProperties.Name="归档日程"><Path Style="{StaticResource TaskIcon}" Data="{StaticResource ArchiveIcon}"/></Button>
         <Button Style="{StaticResource IconButton}" Click="OnRenewClick" ToolTip="{Binding Content.CountdownText, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="延长保留时间"><local:HourglassControl ArchiveAtUtc="{Binding Item.ArchiveAtUtc}" IsRunning="{Binding IsCountdownRunning, RelativeSource={RelativeSource AncestorType=Window}}" AnimationsEnabled="{Binding DataContext.AnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Width="14" Height="14"/></Button>
         <Button Style="{StaticResource IconButton}" Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="{Binding PinTooltip}" AutomationProperties.Name="置顶或取消置顶"><Path Data="{StaticResource PinIcon}"><Path.Style><Style TargetType="Path" BasedOn="{StaticResource TaskIcon}"><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Stroke" Value="{StaticResource IslandAccent}"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Button>
        </StackPanel>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     </Grid>
    </StackPanel>
    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
     <TextBlock Text="岛的位置" Foreground="#F3F4F7" Margin="5,5"/>
     <StackPanel Orientation="Horizontal"><Button Content="左侧" Tag="Left" Click="OnAnchor"/><Button Content="居中" Tag="Center" Click="OnAnchor"/><Button Content="右侧" Tag="Right" Click="OnAnchor"/></StackPanel>
     <CheckBox Content="启用动画" IsChecked="{Binding AnimationsEnabled}" Foreground="#F3F4F7" Margin="6,12"/>
     <TextBlock Text="位置和动画设置在退出后恢复默认。" Foreground="#A8AEBC" Margin="5,0" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel x:Name="ArchivePanel" Visibility="Collapsed">
     <TextBlock Text="归档日程" Foreground="#F3F4F7" Margin="5,4"/>
     <ListBox ItemsSource="{Binding ArchivedTasks}" Height="110" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Height="44"><Button Content="恢复" DockPanel.Dock="Right" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4"/><StackPanel Margin="4"><TextBlock Text="{Binding Title}" Foreground="#F3F4F7" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#939CAD" FontSize="10"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Button Content="加载更多" Command="{Binding LoadMoreArchivesCommand}" Visibility="{Binding HasMoreArchives, Converter={StaticResource BoolVisibility}}" Padding="8,4"/>
    </StackPanel>
    <ScrollViewer x:Name="EditorViewport" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="EditorPanel">
     <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding EditorTime.IsPickerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="日程内容" Foreground="#F3F4F7" Margin="5,4"/>
     <TextBox x:Name="TitleInput" Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsBusy}" MinHeight="40" Margin="3,4" AcceptsReturn="False" VerticalContentAlignment="Center" AutomationProperties.Name="日程内容"/>
     </StackPanel>
     <local:TimePickerControl DataContext="{Binding EditorTime}"/>
     <StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding EditorTime.IsPickerOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Style="{StaticResource PrimaryButton}" Content="保存日程" Command="{Binding SaveCommand}" IsDefault="True"/><Button Style="{StaticResource QuietButton}" Content="取消" Command="{Binding CancelEditCommand}"/></StackPanel>
     <StackPanel Visibility="{Binding ConfirmDiscard, Converter={StaticResource BoolVisibility}}"><TextBlock Text="内容尚未保存" Foreground="#E9C88C" Margin="5,5"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="继续编辑" Command="{Binding KeepEditingCommand}"/><Button Content="放弃修改" Command="{Binding DiscardChangesCommand}"/></StackPanel></StackPanel>
    </StackPanel>
    </ScrollViewer>
    </Grid>
    <TextBlock Text="{Binding Status}" FontSize="11" Margin="5,10,5,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#A6D9B5"/><Style.Triggers><DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="#F2A5A5"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </StackPanel>
  </Canvas>
 </Border>
 </Canvas>
</Window>
